{
	"name": "pi-atelier",
	"version": "0.13.0",
	"description": "A responsive status rail and live activity sidebar for Pi",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"tui",
		"status-bar"
	],
	"files": [
		"extensions",
		"src",
		"assets/demo.png",
		"assets/preview.png",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"image": "https://raw.githubusercontent.com/pvjagtap/pi-atelier/main/assets/preview.png"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pvjagtap/pi-atelier.git"
	},
	"bugs": {
		"url": "https://github.com/pvjagtap/pi-atelier/issues"
	},
	"homepage": "https://github.com/pvjagtap/pi-atelier#readme",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.context-view-tests.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check:pack": "node scripts/verify-pack.mjs",
		"check:audit": "npm audit --audit-level=low",
		"check:install": "node scripts/verify-install.mjs",
		"bench:sidebar": "node scripts/benchmark-sidebar.mjs",
		"bench:workspace": "node scripts/benchmark-workspace.mjs",
		"check": "npm run typecheck && npm run format:check && npm test && npm run test:context-view && npm run check:pack && npm run check:audit && npm run check:install",
		"test:context-view": "node --test tests/context-view/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-tui": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@earendil-works/pi-tui": "^1.0.0",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
